APP_NAME="آله مارکت"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aale_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@aale.ir"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS - MeliPayamak (official SDK: melipayamak/php)
# API Key must be passed as the password argument to MelipayamakApi.
# Pattern body: فروشگاه آله کد تایید شما: {0} shop.aale.ir {1}
# Keep PATTERN_APPROVED=false until the provider confirms pattern approval.
MELIPAYAMAK_ENABLED=true
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_PATTERN_CODE=156526
MELIPAYAMAK_OTP_PATTERN=156526
MELIPAYAMAK_PATTERN_APPROVED=false
MELIPAYAMAK_PATTERN_VARIABLE_COUNT=2
MELIPAYAMAK_PATTERN_SECOND_VALUE="ورود امن"
MELIPAYAMAK_DRIVER=soap
MELIPAYAMAK_TEST_MODE=true
MELIPAYAMAK_OTP_LENGTH=5
MELIPAYAMAK_OTP_EXPIRE=120
MELIPAYAMAK_OTP_MAX_ATTEMPTS=5
MELIPAYAMAK_OTP_RESEND_WAIT=60
MELIPAYAMAK_OTP_DAILY_LIMIT=20
MELIPAYAMAK_OTP_IP_DAILY_LIMIT=40
SMS_DRIVER=melipayamak

# Payment - Zarinpal
PAYMENT_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL="${APP_URL}/payments/zarinpal/callback"

# Inventory
STOCK_RESERVATION_MINUTES=30
LOW_STOCK_THRESHOLD=5

# Store defaults
CURRENCY=IRR
CURRENCY_LABEL=ریال
MIN_ORDER_AMOUNT=0

# Super Admin seeder (used by DatabaseSeeder / SuperAdminSeeder)
SUPER_ADMIN_NAME="مدیر سیستم"
SUPER_ADMIN_MOBILE=09120000000
SUPER_ADMIN_EMAIL=admin@aale.ir
SUPER_ADMIN_PASSWORD=
